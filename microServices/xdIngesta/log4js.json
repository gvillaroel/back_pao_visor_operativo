{
  "appenders": {
    "console": {
      "type": "console"
    },
    "file": {
      "type": "file",
      "filename": "logs/server.log",
      "maxSize": 10485760,
      "backups": 5,
      "pattern": "-yyyy-MM-dd",
      "maxFiles": 14
    }
  },
  "categories": {
    "default": {
      "appenders": [
        "console",
        "file"
      ],
      "level": "info"
    }
  }
}