# Ambiente y Servidor
DESC_ENV=DEV
PORT=4015
TIME_ZONE="America/Mexico_City"

# Servicio OMS Inventario
#OMS_INVENTORY_URL=http://api-omsweb-visor-qa.liverpool.com.mx/oms/api/inventario/pos/skus
OMS_INVENTORY_URL=https://api.watsoncommerce.ibm.com/inventory/{tenantId}/v2/availability/node

# Autenticación OAuth2 OMS
OMS_AUTH_URL=https://api.watsoncommerce.ibm.com
OMS_AUTH_PATH=/inventory/{tenantId}/v1/oauth2/token
OMS_TENANT_ID=0002
OMS_CLIENT_ID=cliente_oms_id
OMS_CLIENT_SECRET=cliente_oms_secret

# Tiempo de caché del token en segundos (43200 = 12 horas, 86400 = 1 día)
OMS_TOKEN_CACHE_EXPIRES_IN_SEC=43200

# *** Circuit breaker compartido por autenticación y consulta de inventario OMS ***
# Tiempo máximo de espera para cada solicitud antes de que el circuit breaker la considere fallida 30sec Auth / 10sec Inventory Request
OMS_CIRCUIT_BREAKER_TIMEOUT_MS=45000
# Tiempo que debe transcurrir antes de que el circuit breaker intente reabrir la conexión
OMS_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# SSL
REJECT_UNAUTHORIZED_SSL=false

# Google Cloud Pub/Sub
GCP_PROJECT_ID=gcp-project-id-example
PUBSUB_SUBSCRIPTION_IV=sub-iv-availability-dev
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_IV=iv-inventory-updates
KAFKA_GROUP_ID=node-availability-inventory
KAFKA_CLIENT_ID=node-availability

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASS=postgres
DB_NAME=PAO_VO
DB_SCHEMA=cnpao
